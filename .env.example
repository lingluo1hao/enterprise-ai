# ============================================================
# Enterprise AI — 环境配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- LLM 服务 ---
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2:7b"
# 主力模型（生成/规划）；网关还会把分类/打分/改写/压缩等轻量任务路由到 qwen2.5:1.5b

# --- Embedding 服务（文档/问题向量化）---
# Embedding 后端：仅提供 Ollama 模式（走 Ollama 的 bge-m3，主进程零 torch，根治 segfault，吞吐更高）
EMBED_BACKEND="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
# Ollama embedding 服务地址
OLLAMA_EMBED_MODEL="bge-m3"
# Ollama embedding 模型；dim=1024，中文多语质量优

# --- MySQL 数据库 ---
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="rag_agent"

# --- Redis 缓存 ---
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="your_redis_password"
REDIS_DB="0"

# --- 通义千问 API（可选） ---
DASHSCOPE_API_KEY="your_api_key_here"

# --- Milvus 向量库（唯一向量后端）---
# 服务端：虚拟机 192.168.200.128 上 Milvus standalone（端口 19530）
MILVUS_URI="http://192.168.200.128:19530"
MILVUS_COLLECTION="rag_docs"


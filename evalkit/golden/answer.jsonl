# 答案层黄金集 —— 每行一条 case
#
# 【与检索黄金集的区别】
#   检索层只问"该找的段落找到没"，答案层问"最终回答对不对"。
#   跑这层要走完整问答链路 + 调 LLM judge，有成本，所以条数控制在检索集的一半以内，
#   优先覆盖「最容易出错」和「错了代价最大」的场景。
#
# 【字段说明】
#   reference         参考答案，judge 用它做语义比对（不要求逐字一致）
#   must_include      必须出现的要点，字符串匹配，零成本硬判据
#   must_not_include  不能出现的内容，专门抓已知的高频幻觉
#   should_refuse     该拒答。知识库里没有的东西硬编一个答案，
#                     比老实说"不知道"危害大得多 —— 这类 case 是幻觉的照妖镜
#
# 【为什么 must_include 只写关键 token 而不写整句】
#   写整句会因为措辞变化误判失败，噪声太大。
#   只卡"协议号 0x01""GPS > WIFI"这种不可替换的事实锚点，
#   既能抓住实质错误，又不会因为换个说法就报红。
#
# ---------------------------------------------------------------------------
# 事实类：答案有唯一正确锚点，最容易自动判分
# ---------------------------------------------------------------------------
{"case_id": "ans-jm-001", "query": "登录包的协议号是多少", "tenant_id": "jm", "role": "admin", "tags": ["fact-lookup"], "reference": "登录包的协议号是 0x01。终端与服务器建立连接后首先发送登录请求包，服务器返回登录回复包。", "must_include": ["0x01"], "must_not_include": ["0x36", "0x1F"]}
{"case_id": "ans-jm-002", "query": "心跳包用哪个协议号", "tenant_id": "jm", "role": "admin", "tags": ["fact-lookup"], "reference": "心跳包的协议号是 0x36，由终端定时发送，服务器收到后回复心跳回复包。", "must_include": ["0x36"], "must_not_include": ["regex:心跳包[^\\n。]{0,40}0x01"]}
{"case_id": "ans-jm-003", "query": "通用协议包由哪几部分组成", "tenant_id": "jm", "role": "admin", "tags": ["format"], "reference": "通用协议包由起始位、包长度、协议号、信息内容、序列号、校验位和停止位等字段依次组成。", "must_include": ["起始位", "校验"], "must_not_include": []}
{"case_id": "ans-yh-001", "query": "V2、KA、WIFIMAC 分别代表什么数据", "tenant_id": "yh", "role": "admin", "tags": ["fact-lookup"], "reference": "V2 是 GPS 定位情况下的定位数据；WIFIMAC 是 WIFI 定位数据；KA 是基站数据，定位间隔较长时 KA 同时充当心跳数据。", "must_include": ["GPS", "WIFI", "基站"], "must_not_include": []}
{"case_id": "ans-yh-002", "query": "三种定位数据的上报优先级是什么", "tenant_id": "yh", "role": "admin", "tags": ["fact-lookup", "rule"], "reference": "定位数据优先级为 GPS > WIFI > LBS，设备按此优先级上报。", "must_include": ["GPS", "WIFI", "LBS"], "must_not_include": []}
{"case_id": "ans-yh-003", "query": "白名单号码打不通会怎么处理", "tenant_id": "yh", "role": "admin", "tags": ["rule"], "reference": "顺序拨打白名单中的 1-3 个号码，直到有人接听为止；如果一直无人接听，拨打 3 个循环后停止，且不发送短信。", "must_include": ["3", "循环"], "must_not_include": ["短信通知", "会发送短信"]}
#
# ---------------------------------------------------------------------------
# 拒答类：知识库里没有的信息，正确行为是明确说"资料中没有"
# 这类 case 权重最高 —— 编造一个看似合理的答案，比答不出来危险得多
# ---------------------------------------------------------------------------
{"case_id": "ans-refuse-001", "query": "这款个人定位终端的出厂价格是多少人民币", "tenant_id": "jm", "role": "admin", "tags": ["refuse", "hallucination-trap"], "reference": "通讯协议文档中不包含价格信息，应明确告知资料中未涉及。", "must_include": [], "must_not_include": [], "should_refuse": true, "note": "协议文档只讲通信格式，不含任何商务信息"}
{"case_id": "ans-refuse-002", "query": "设备的电池容量和续航时间是多少", "tenant_id": "yh", "role": "admin", "tags": ["refuse", "hallucination-trap"], "reference": "通讯协议文档不涉及硬件规格，应说明资料中没有相关内容。", "must_include": [], "must_not_include": [], "should_refuse": true, "note": "硬件参数属于规格书范畴，不在通讯协议里"}
{"case_id": "ans-refuse-003", "query": "0xFF 协议包的字段定义是什么", "tenant_id": "jm", "role": "admin", "tags": ["refuse", "hallucination-trap"], "reference": "协议中不存在 0xFF 协议号，应指出该协议号未定义，而不是编造字段表。", "must_include": [], "must_not_include": ["0xFF 包由", "起始位 0xFF"], "should_refuse": true, "note": "不存在的协议号，最典型的幻觉诱饵"}
